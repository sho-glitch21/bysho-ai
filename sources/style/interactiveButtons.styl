.touch-buttons
    display none
    position absolute
    bottom 0
    left 0
    height 0
    width 100%
    pointer-events none
    -webkit-user-select none
    -moz-user-select none
    user-select none

    &.is-active
        display block
    
    .overlay
        display none
        position absolute
        left 0
        bottom 0
        width 100%
        min-height 90px
        height 15vh
        background radial-gradient(ellipse farthest-side at bottom, #1D1721, #1D172100)
        background linear-gradient(#1D172100, #1D172199)

        &.is-visible
            display block

    .list
        display flex
        align-items center
        justify-content center
        position absolute
        bottom 0
        left 0
        width 100%
        color #ffffff
        font-family "Amatic SC", sans-serif
        font-weight 700
        font-size 64px
        min-height 120px
        height 20vh

        @media only screen and (max-width 520px)
            font-size 48px

        button
            display none
            height 80px
            justify-content center
            align-items center
            padding-left 7vw
            padding-right 7vw
            pointer-events auto

            &.is-visible
                display flex

            &.interact
            &.unstuck
                @media only screen and (max-width 520px)
                    padding-left 3.5vw
                    padding-right 3.5vw

        .previous
            &::after
                content ''
                display block
                width 20px
                height 36px
                background url('../ui/actions/actions-icon-arrow.webp')
                background-size 20px 36px

        .next
            &::after
                content ''
                display block
                width 20px
                height 36px
                background url('../ui/actions/actions-icon-arrow.webp')
                background-size 20px 36px
                transform rotate(180deg)

        .close
            &::after
                content ''
                display block
                width 36px
                height 36px
                background url('../ui/actions/actions-icon-close.webp')
                background-size 36px 36px

        .open
            &::after
                content ''
                display block
                width 38px
                height 38px
                background url('../ui/actions/actions-icon-open.webp')
                background-size 38px 38px

        .boost
            position absolute
            left 4vw
            bottom 18px
            height 58px
            min-width 108px
            padding-left 18px
            padding-right 18px
            border 1px solid rgba(255, 255, 255, 0.8)
            border-radius 999px
            background rgba(29, 23, 33, 0.72)
            color #ffffff
            font-family "Nunito", sans-serif
            font-size 15px
            font-weight 900
            letter-spacing 0.12em
            text-shadow 0 0 12px rgba(255, 255, 255, 0.35)
            backdrop-filter blur(8px)
            -webkit-backdrop-filter blur(8px)
            touch-action none

            &.is-pressed
                background rgba(255, 255, 255, 0.92)
                color #1D1721
                box-shadow 0 0 24px rgba(255, 255, 255, 0.4)


/* Nitro boost feedback: a subtle cyan/amber energy bloom around the screen edges. */
.boost-vfx
    position absolute
    inset 0
    z-index 4
    pointer-events none
    opacity 0
    background radial-gradient(ellipse at center, transparent 45%, rgba(42, 220, 255, 0.08) 72%, rgba(255, 135, 55, 0.22) 100%)
    transition opacity 180ms ease-out

    &::before
        content ''
        position absolute
        inset 0
        background linear-gradient(110deg, transparent 35%, rgba(105, 232, 255, 0.12) 50%, transparent 65%)
        transform translateX(-100%)
        opacity 0

html.is-boosting
    .boost-vfx
        opacity 1
        animation nitro-pulse 420ms ease-in-out infinite alternate

        &::before
            opacity 1
            animation nitro-streak 520ms linear infinite

    .touch-buttons .boost
        border-color rgba(100, 235, 255, 0.98)
        box-shadow 0 0 22px rgba(42, 220, 255, 0.55), inset 0 0 14px rgba(42, 220, 255, 0.15)

@keyframes nitro-pulse
    from
        opacity 0.55
    to
        opacity 1

@keyframes nitro-streak
    from
        transform translateX(-100%)
    to
        transform translateX(100%)
